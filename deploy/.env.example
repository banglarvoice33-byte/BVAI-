# Copy to deploy/.env. Never publish this file.
NEXT_PUBLIC_SITE_URL=https://your-site.example
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEWSROOM_INGEST_KEY=
CRON_SECRET=
AUTO_PUBLISH=false
# Use a local OpenAI-compatible server for an infrastructure-independent AI option.
# Local models still need hardware/electricity and separate quality evaluation.
CHAT_AI_BASE_URL=http://host.docker.internal:11434/v1
CHAT_AI_MODEL=
CHAT_AI_KEY=
RELEASE_GITHUB_REPOSITORY=
# Required only for Vault/bootstrap/backup scripts, never exposed to browser.
SUPABASE_DB_URL=
SUPABASE_DB_CA=

SOCIAL_AUTOMATION_ENABLED=false

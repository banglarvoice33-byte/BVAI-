diff --git a/frontend/lib/polling.ts b/frontend/lib/polling.ts
new file mode 100644
index 0000000..053bb87
--- /dev/null
+++ b/frontend/lib/polling.ts
@@ -0,0 +1,37 @@
+/**
+ * Completion-based polling: never overlap requests or let stale work update an unmounted owner.
+ * The task must pass its signal to fetch and check signal.aborted before committing state.
+ */
+export function startPolling(
+  task: (signal: AbortSignal) => Promise<void>,
+  intervalMs: number,
+  timeoutMs = 15_000,
+): () => void {
+  if (!Number.isFinite(intervalMs) || intervalMs <= 0 || !Number.isFinite(timeoutMs) || timeoutMs <= 0) {
+    throw new Error('Polling intervals must be positive finite numbers');
+  }
+  let stopped = false;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  let controller: AbortController | undefined;
+  const tick = async () => {
+    if (stopped) return;
+    const request = new AbortController();
+    controller = request;
+    const deadline = setTimeout(() => request.abort(), timeoutMs);
+    try {
+      await task(request.signal);
+    } catch {
+      // A transient failure must not blank already-rendered content or stop later refreshes.
+    } finally {
+      clearTimeout(deadline);
+      if (controller === request) controller = undefined;
+      if (!stopped) timer = setTimeout(() => { void tick(); }, intervalMs);
+    }
+  };
+  void tick();
+  return () => {
+    stopped = true;
+    clearTimeout(timer);
+    controller?.abort();
+  };
+}
diff --git a/frontend/lib/video-identity.ts b/frontend/lib/video-identity.ts
new file mode 100644
index 0000000..61b6070
--- /dev/null
+++ b/frontend/lib/video-identity.ts
@@ -0,0 +1,14 @@
+type VideoIdentity = { id?: string; youtube_id?: string; embed_url?: string; video_url?: string; title_bn?: string; title_en?: string };
+
+/** Identify the asset, never the rotating signed URL query or an object snapshot. */
+export function videoIdentity(video: VideoIdentity): string {
+  if (video.id) return `id:${video.id}`;
+  if (video.youtube_id) return `youtube:${video.youtube_id}`;
+  if (video.embed_url) return `embed:${video.embed_url}`;
+  if (video.video_url) return `file:${video.video_url.split('?')[0]}`;
+  return `title:${video.title_bn || video.title_en || ''}`;
+}
+
+export function selectedVideo<T extends VideoIdentity>(videos: T[], identity: string | null): T | undefined {
+  return identity ? videos.find((video) => videoIdentity(video) === identity) : undefined;
+}

recovery.bvai.enc
recovery.tar.gz
.bvaipatch-backups/
supabase/.temp/
BVAI-download/
__pycache__/
*.pyc
*.patch
backup/
backup_*.dump
backup_*.sql
migration_before.txt
banglarvoice24news-release.keystore
bv-pass.txt

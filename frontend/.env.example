# Copy to .env.local. Configure new accounts only; never commit secrets.
NEXT_PUBLIC_SITE_URL=https://your-site.example
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEWSROOM_INGEST_KEY=
CRON_SECRET=
# Optional: APK release repository owner/name (not a URL), or direct HTTPS APK URL.
RELEASE_GITHUB_REPOSITORY=
READER_APK_URL=
# Optional integrations: leave empty to avoid provisioning extra services.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional integrations; provision deliberately, never copy old IDs.
GITHUB_REPO=
GITHUB_DISPATCH_TOKEN=
YOUTUBE_CHANNEL_ID=
NEXT_PUBLIC_STREAM_URL=
SOCIAL_AUTOMATION_ENABLED=false

# Merge these options into .env; NEVER overwrite existing keys with blanks.
# Node >=22.12. Use GitHub Secrets for credentials, Variables for non-secret options.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only migration deployment needs a database connection string, not the video worker.
SUPABASE_DB_URL=
# Optional trusted CA file; never disable TLS verification.
SUPABASE_DB_CA_FILE=

VIDEO_PUBLISH_MODE=review
VIDEO_TARGET_SECONDS=60
# Optional exact text budget, otherwise target_seconds * 18.
# VIDEO_SCRIPT_MAX_CHARS=1080
VIDEO_PRESET=medium
# Bound encoder/filter parallelism on constrained CI and Termux; integer 1–16.
VIDEO_THREADS=2
# Rendering requires libass shaping=complex; captionless fallback is intentionally refused.
# Apply 20261113000000_render_heartbeat_fencing.sql before deploying the updated renderer.
VIDEO_REQUIRE_CAPTIONS=true
VIDEO_CONTAINS_SYNTHETIC_MEDIA=false
GROQ_API_KEY=
# Existing TTS_*_1..N provider keys remain unchanged.
# Edge matching fallback is unofficial: do not assume uptime/service guarantees.
EDGE_CAPTION_FALLBACK=false

# Optional Agnes visual provider. Keep VIDEO_VISUAL_PROVIDER=licensed for the
# existing rights-checked path. Agnes is opt-in and remains server-side only.
VIDEO_VISUAL_PROVIDER=licensed
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_API_KEY=
# Optional ordered fallback keys; keep all values server-side. The legacy key above remains supported.
AGNES_API_KEY_1=
AGNES_API_KEY_2=
AGNES_API_KEY_3=
AGNES_API_KEY_4=
AGNES_API_KEY_5=
AGNES_MODEL=agnes-video-2.5-flash
AGNES_SIZE=720P
AGNES_ASPECT_RATIO=9:16
AGNES_POLL_INTERVAL_MS=1500
AGNES_TIMEOUT_MS=600000

# All publication automation OFF until staging + manual pilot pass.
VIDEO_DELIVERY_ENABLED=false
# Supported: youtube,facebook,instagram,tiktok (comma-separated)
VIDEO_DELIVERY_PLATFORMS=youtube,facebook,instagram
VIDEO_DISTRIBUTION_WORKER_ENABLED=false
ENABLE_VIDEO_AUTOMATION=false
YOUTUBE_CHANNEL_ID=
YOUTUBE_PRIVACY=unlisted
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
SOCIAL_FACEBOOK_PAGE_ID=
SOCIAL_FACEBOOK_PAGE_TOKEN=
SOCIAL_INSTAGRAM_BUSINESS_ACCOUNT_ID=
SOCIAL_INSTAGRAM_ACCESS_TOKEN=
# Explicitly select a version verified for your Meta app (e.g. v21.0 if supported).
FACEBOOK_GRAPH_VERSION=

# TikTok Content Posting API (Direct Post). Domain verification file is under frontend/public/.
# Client key/secret live in Supabase Vault; user access token + open_id required per creator.
TIKTOK_OPEN_ID=
TIKTOK_ACCESS_TOKEN=
# SELF_ONLY until TikTok audits the app for public posts.
TIKTOK_PRIVACY=SELF_ONLY
# Optional vault service names already used by worker: TIKTOK_ACCESS_TOKEN, TIKTOK_CLIENT_KEY, TIKTOK_CLIENT_SECRET

# A truthful contact UA is required by Wikimedia operational policy.
BVAI_USER_AGENT=BVAI/2.0 (replace-with-your-site-and-contact)
# REQUIRED for CI rendering: random 32-byte base64 key, kept in GitHub Secrets.
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VIDEO_RECOVERY_KEY=

# Reader-first / asset-bound review release. Merge; do not replace live .env.
# OFF by default. Enable only after both new migrations + staging pilot.
VIDEO_TTS_PROVIDER_ORDER=azure,elevenLabs,sarvam
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_BENGALI_VOICE=bn-BD-NabanitaNeural
AZURE_SPEECH_RATE_PERCENT=-4
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Exact normalized lexical agreement is NOT a phonetic/pronunciation guarantee.
CAPTION_MIN_SCRIPT_MATCH=1.0
# Frontend-only settings; secrets must NEVER have NEXT_PUBLIC_ prefix.
BVAI_DEMO_MODE=false
NEXT_PUBLIC_ENABLE_LEARNING_HUB=false
NEXT_PUBLIC_EDITORIAL_EMAIL=

# Enhanced policy v2; apply 20261116000000 and 20261116001000 on staging FIRST.
# VIDEO_PUBLISH_MODE=review stays the safe default. After staging, website enables
# automatic trusted-source delivery; reporter content still requires editor approval.
# Optional source-sentence planning: no LLM is called by default.
VIDEO_SCRIPT_AI_ENABLED=false
VIDEO_SCRIPT_PROVIDERS=openai,anthropic,gemini
VIDEO_SCRIPT_OPENAI_MODEL=
VIDEO_SCRIPT_ANTHROPIC_MODEL=
VIDEO_SCRIPT_GEMINI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Use dedicated server-side keys and explicit compatible model IDs; never NEXT_PUBLIC_.
# Rendering remains a separate Linux/FFmpeg worker, not a Vercel/Cloudflare HTTP function.

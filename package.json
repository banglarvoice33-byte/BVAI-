{
  "name": "banglarvoice-scripts",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "dotenv": "^18.0.6",
    "pg": "^8.23.1"
  },
  "type": "module",
  "scripts": {
    "test": "node --test scripts/pipeline/tests/*.test.mjs scripts/pipeline/quality-v3/*.test.mjs",
    "test:captions": "python3 -m unittest discover -s scripts/pipeline/tests -p 'test_*.py'",
    "test:render": "node scripts/pipeline/tests/render-smoke.mjs",
    "check:imports": "node scripts/pipeline/check-imports.mjs",
    "check:publish-gate": "cmp -s worker/src/lib/publish-gate.ts frontend/lib/publish-gate.ts",
    "preflight": "node scripts/pipeline/readiness.mjs"
  },
  "engines": {
    "node": ">=22.12"
  }
}
